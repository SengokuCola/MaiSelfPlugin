{
  "manifest_version": 2,
  "version": "0.2.0",
  "name": "照片上的人是你吗？",
  "description": "管理员标注、训练与版本管理；自动识别收到的图片并添加自身角色上下文提示。",
  "author": {
    "name": "SengokuCola",
    "url": "https://github.com/SengokuCola"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/SengokuCola/MaiSelfPlugin",
    "homepage": "https://github.com/SengokuCola/MaiSelfPlugin",
    "documentation": "https://github.com/SengokuCola/MaiSelfPlugin#readme",
    "issues": "https://github.com/SengokuCola/MaiSelfPlugin/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.11.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=11,<13"
    },
    {
      "type": "python_package",
      "name": "numpy",
      "version_spec": ">=2,<3"
    }
  ],
  "capabilities": [
    "webui.claim_upload",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "maibot.mai-recog-self",
  "plugin_type": "media",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "scan-face",
      "background": "#F7F1E4"
    }
  }
}
